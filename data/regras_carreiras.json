  "pontuacao": {
    "formula": "compatibilidade(trilha) = clamp( soma(peso_pergunta * peso_etapa * (resposta-min)/(max-min)) / soma(peso_pergunta * peso_etapa) + soma(ajustes das regras ativas), 0, 1 )",
